# Copy to %USERPROFILE%\.asset_assembly_automator\secrets.env
# Never commit real keys to git.

# Required for Meshy stages (image-to-3D, rig, animate, export)
MESHY_API_KEY=your_meshy_api_key_here

# Optional — concept art / uprez (skip if using Midjourney drop or manual PNG)
MAGNIFIC_API_KEY=your_magnific_api_key_here

# Optional — Higgsfield MCP/REST concept generate (Workflow Use Higgs / s02)
# HF_MCP_ACCESS_TOKEN=your_token_here

# Higgsfield REST fallback (if higgsfield.provider: rest in config):
# HF_CREDENTIALS=api_key:api_secret

# Cursor CLI (Unity import via workflow app):
# CURSOR_API_KEY=your_cursor_api_key_here
